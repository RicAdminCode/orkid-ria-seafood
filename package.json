{
  "name": "orkid-ria-seafood",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && wrangler d1 migrations apply DB --local && wrangler dev --port 3123 --var SITE_ORIGIN:http://localhost:3123",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "deploy": "pnpm check && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "pnpm types && tsc && tsc -p tsconfig.frontend.json",
    "db:create": "wrangler d1 migrations create DB",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "check": "pnpm typecheck && pnpm test && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@tanstack/query-core": "^5.106.0",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
