{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orkid-ria-seafood",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "orkid-ria-reviews", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "SITE_ORIGIN": "http://localhost:3123" },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": false }
}
