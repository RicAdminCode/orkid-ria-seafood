{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orkid-ria-seafood",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orkid-ria-reviews",
      "database_id": "76121acd-6962-472e-ab64-76f0d0cdbc98",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://orkid-ria-seafood.steep-mud-60fb.workers.dev"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
